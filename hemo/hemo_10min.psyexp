      <Param name="random seed" updates="None" val="" valType="code"/>
    </LoopInitiator>
    <Routine name="show_instruction"/>
    <LoopTerminator name="repeat"/>
    <Routine name="stable_end"/>
  </Flow>
</PsychoPy2experiment>
